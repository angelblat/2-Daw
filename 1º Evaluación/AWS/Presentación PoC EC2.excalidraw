  "elements": [
    {
      "id": "nzPQouWjtDj74D2AI1amC",
      "type": "text",
      "x": 166.4645323255877,
      "y": 73.65934187233407,
      "width": 1281.6177978515625,
      "height": 1844.0059821986267,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
