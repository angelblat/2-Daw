      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1737614056,
      "version": 5350,
      "versionNonce": 912719896,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Dp4NdB_a0opcDsz2_ZWeU",
